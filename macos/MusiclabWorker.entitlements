<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The hardened runtime is required for notarization, and it forbids by
	     default three things this bundle genuinely does. Each of these is a
	     hole, so each is here for a stated reason and no others are opened. -->

	<!-- numba and llvmlite compile machine code at runtime and jump into it. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>

	<!-- Python opens 300-odd native extensions by path at import time. They
	     are all signed here with the same certificate, but torch and
	     onnxruntime also dlopen siblings through their own loaders, which
	     library validation reads as loading foreign code. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
