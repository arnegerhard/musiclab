# Python
.venv/
__pycache__/
*.egg-info/
*.pyc

# Generated audio and model weights — gigabytes, all reproducible
out/
models/

# Xcode. The iOS project is edited by hand in Xcode and tracked, along with
# the Info.plist and entitlements it owns. Only per-user window state and
# build products are ignored.
ios/build/
DerivedData/
xcuserdata/
*.xcworkspace/xcshareddata/IDEWorkspaceChecks.plist

.DS_Store

# Accounts: password hashes and live session tokens. Never commit this.
musiclab.db
musiclab.db-shm
musiclab.db-wal

# Built worker bundles
dist/
macos/build/
macos/*.xcodeproj/

# Wrangler's local cache: this machine's Cloudflare account, not the project's.
.wrangler/

# uv's resolved lockfile. Nothing here installs from it: the worker bundle is
# built with `uv pip install` against pyproject, and Modal builds its own image.
uv.lock

# The worker's status file, written into the checkout when the worker runs on
# a checkout's own interpreter rather than a bundled one.
status.json
